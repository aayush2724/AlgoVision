# Backend (FastAPI) — copy to backend/.env for local runs. Never commit .env.
# Every value here has a safe default; none is a secret except INTERNAL_TOKEN.

# "dev" exposes /docs and /openapi.json; anything else hides them. Render sets prod.
ENV=dev

# Where the ML microservice lives. A bare hostname is accepted (Render passes
# one); the scheme is inferred — localhost → http, anything else → https.
ML_SERVICE_URL=http://localhost:8500

# Comma-separated browser origins allowed to call the API directly, or "*".
# Production traffic comes through the Vercel /api rewrite (same origin), so
# this only matters for callers that hit the Render URL directly.
BACKEND_CORS_ORIGINS=http://localhost:5500,http://localhost:8080

# Shared secret sent to the ML service as X-Internal-Token. Leave empty for
# Docker/local (the ML service then relies on its private-network check);
# Render generates one and shares it between the two services.
INTERNAL_TOKEN=

# Set to 1 only in tests — disables the per-IP rate limits.
# ALGOVISION_DISABLE_RATELIMIT=1
