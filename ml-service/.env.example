# ML service — copy to ml-service/.env for local runs. Never commit .env.

# Groq API key for live AI narration and bug hints. Without it the service
# still runs and returns template/static-analysis responses (live: false).
# When set, the pasted code and the current trace step are sent to Groq —
# the privacy policy (frontend/js/pages.js, #/privacy) describes this.
GROQ_API_KEY=

# Must equal the backend's INTERNAL_TOKEN. When set, every request except
# /health must carry a matching X-Internal-Token header; when empty, only
# loopback/private-network callers are accepted (Docker / start-dev.sh).
INTERNAL_TOKEN=

# Declared in app/config.py but not used by the current code.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
